{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apprenticeops.local/schema/model.schema.json",
  "title": "ApprenticeOps Model Lock Row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "publisher",
    "family",
    "params_b",
    "tier",
    "architecture",
    "training_type",
    "quantization",
    "runtime",
    "artifact_size_gb",
    "source_url",
    "license",
    "license_url",
    "license_status",
    "license_class",
    "ollama_digest",
    "gguf_sha256",
    "context_length",
    "included",
    "runtime_options",
    "llama_cpp_status",
    "track",
    "exclusion_reason",
    "downloaded_at",
    "metadata_status",
    "roster_bracket",
    "legacy_bracket",
    "measured_snapshot",
    "notes"
  ],
  "properties": {
    "model_id": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "family": {"type": "string", "minLength": 1},
    "params_b": {"type": ["number", "null"]},
    "tier": {"type": ["string", "null"], "enum": ["T1", "T2", "T3", "T4", "T5", null]},
    "architecture": {"type": "string", "enum": ["dense", "moe", "hybrid", "unknown"]},
    "training_type": {"type": "string", "enum": ["base", "instruct", "chat", "code", "reasoning", "distilled", "unknown"]},
    "quantization": {"type": "string", "minLength": 1},
    "runtime": {"type": "string", "enum": ["ollama", "gguf", "llama.cpp", "mlx", "onnx", "other"]},
    "runtime_options": {
      "type": "array",
      "items": {"type": "string", "enum": ["ollama", "llama.cpp", "mlx", "onnx", "other"]},
      "uniqueItems": true
    },
    "llama_cpp_status": {"type": "string", "enum": ["direct_gguf", "ollama_wrapped_gguf_unverified", "not_applicable", "unknown"]},
    "artifact_size_gb": {"type": ["number", "null"]},
    "source_url": {"type": "string"},
    "license": {"type": "string"},
    "license_url": {"type": "string"},
    "license_status": {"type": "string", "enum": ["exact_source", "family_policy", "unknown"]},
    "license_class": {"type": "string", "enum": ["permissive", "custom", "noncommercial", "unknown"]},
    "ollama_digest": {"type": ["string", "null"]},
    "gguf_sha256": {"type": ["string", "null"]},
    "context_length": {"type": ["integer", "null"]},
    "included": {"type": "boolean"},
    "track": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "exclusion_reason": {"type": ["string", "null"]},
    "downloaded_at": {"type": ["string", "null"]},
    "metadata_status": {"type": "string", "enum": ["measured", "inferred", "needs_metadata"]},
    "roster_bracket": {"type": ["string", "null"]},
    "legacy_bracket": {"type": ["string", "null"]},
    "measured_snapshot": {"type": "boolean"},
    "notes": {"type": "string"}
  }
}