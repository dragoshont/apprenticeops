{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apprenticeops.local/schema/scenario-lifecycle.schema.json",
  "title": "ApprenticeOps Scenario Lifecycle Metadata",
  "description": "Optional v1 metadata for future scenario candidates. It makes the operational object, task lifecycle, fault, evidence, action surface, evaluator, promotion state, and source trace explicit without changing locked paper scenarios.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operational_object",
    "task_lifecycle",
    "fault_model",
    "workload_evidence",
    "action_surface",
    "evaluator_shape",
    "promotion_status",
    "source_trace"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operational_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "service",
            "component",
            "network",
            "database",
            "infrastructure",
            "security-control",
            "agent",
            "evaluation-harness",
            "other"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string"
        },
        "boundary": {
          "type": "string"
        }
      }
    },
    "task_lifecycle": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "detect",
          "localize",
          "diagnose",
          "analyze",
          "mitigate",
          "verify",
          "communicate",
          "prevent"
        ]
      }
    },
    "fault_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "manifestation"],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "misconfig",
            "dependency",
            "capacity",
            "regression",
            "security",
            "data",
            "agent-failure",
            "observability",
            "test",
            "other"
          ]
        },
        "manifestation": {
          "type": "string",
          "minLength": 1
        },
        "injected": {
          "type": "boolean"
        }
      }
    },
    "workload_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channels", "source_quality"],
      "properties": {
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "logs",
              "metrics",
              "traces",
              "events",
              "config",
              "user-impact",
              "test-output",
              "deployment-metadata",
              "synthetic-summary"
            ]
          }
        },
        "source_quality": {
          "type": "string",
          "enum": [
            "synthetic",
            "pattern-only",
            "row-derived",
            "measured",
            "live-capture"
          ]
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseline": {"type": "string"},
            "current": {"type": "string"},
            "anomaly": {"type": "string"}
          }
        }
      }
    },
    "action_surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "destructive_risk"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "prose-only",
            "json-tool-plan",
            "read-only-tools",
            "gitops-plan",
            "kubectl-plan",
            "live-mutation"
          ]
        },
        "destructive_risk": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        },
        "permitted_actions": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "forbidden_actions": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "evaluator_shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic_checks", "judge_rubric"],
      "properties": {
        "deterministic_checks": {"type": "boolean"},
        "judge_rubric": {"type": "boolean"},
        "runtime_validator": {"type": "boolean"},
        "human_review": {"type": "boolean"},
        "adversarial_fixtures": {"type": "boolean"}
      }
    },
    "promotion_status": {
      "type": "string",
      "enum": ["candidate", "dev", "locked-core", "retired"]
    },
    "source_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use", "row_status"],
      "properties": {
        "use": {
          "type": "string",
          "enum": ["original", "synthetic", "pattern-family", "row-derived", "telemetry-derived"]
        },
        "row_status": {
          "type": "string",
          "enum": ["none", "not-reviewed", "hash-only", "row-reviewed", "redistributable"]
        },
        "source_families": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "rights_gate": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}